package granbluebosses.cards.wedges;

import com.megacrit.cardcrawl.actions.AbstractGameAction;
import com.megacrit.cardcrawl.actions.common.ApplyPowerAction;
import com.megacrit.cardcrawl.actions.common.DamageAllEnemiesAction;
import com.megacrit.cardcrawl.actions.common.DrawCardAction;
import com.megacrit.cardcrawl.actions.common.GainBlockAction;
import com.megacrit.cardcrawl.cards.AbstractCard;
import com.megacrit.cardcrawl.characters.AbstractPlayer;
import com.megacrit.cardcrawl.core.AbstractCreature;
import com.megacrit.cardcrawl.core.CardCrawlGame;
import com.megacrit.cardcrawl.dungeons.AbstractDungeon;
import com.megacrit.cardcrawl.localization.CardStrings;
import com.megacrit.cardcrawl.monsters.AbstractMonster;
import com.megacrit.cardcrawl.powers.*;
import granbluebosses.cards.BaseCard;
import granbluebosses.relics.ancients.OppressusFragorRelic;
import granbluebosses.util.CardStats;
import granbluebosses.util.primalcards.PrimalColor;

import java.util.Arrays;
import java.util.HashSet;

public class WedgesOfTheSky extends BaseCard {

    public static final String ID = makeID(WedgesOfTheSky.class.getSimpleName());
    public static final CardStrings currCardStrings = CardCrawlGame.languagePack.getCardStrings(ID);
    ; //makeID adds the mod ID, so the final ID will be something like "modID:MyCard"

    //These will be used in the constructor. Technically you can just use the values directly,
    //but constants at the top of the file are easy to adjust.
    private static final int DAMAGE = 4;
    private static final int UPG_DAMAGE = 1;
    private static final int BLOCK = 4;
    private static final int UPG_BLOCK = 1;
    private static final int MAGIC_NUMBER = 1;
    private static final int UPG_MAGIC_NUMBER = 1;
    private static final int COST = -2;
    private static final int UPG_COST = -2; // New number, not added to base cost
    private static final boolean EXHAUST = false;
    private static final boolean EXHAUST_UPG = false;
    private static final boolean ETHEREAL = false;
    private static final boolean UPG_ETHEREAL = false;
    private static final boolean RETAIN = false;
    private static final boolean UPG_RETAIN = false;
    private static final boolean INNATE = false;
    private static final boolean UPG_INNATE = false;
    private static final boolean PURGE = false;
    private static final boolean UPG_PURGE = false;
    private static final boolean FOCUS_SCALING = false;
    private static final CardTags[] cardTags = {

    };
    public enum ACTIONS_ENUM{
        ATTACK,
        DEFEND,
        BUFF_STRENGTH,
        BUFF_DEXTERITY,
        DEBUFF_WEAK,
        DEBUFF_VULNERABLE,
        DRAW
    }

    public HashSet<ACTIONS_ENUM> actionsOnUse;


    private static final CardStats info = new CardStats(
            null, // PrimalColor.GBF_PRIMAL_COLOR //The card color. If you're making your own character, it'll look something like this. Otherwise, it'll be CardColor.RED or similar for a basegame character color.
            null, //CardType.SKILL //The type. ATTACK/SKILL/POWER/CURSE/STATUS
            CardRarity.CURSE, //Rarity. BASIC is for starting cards, then there's COMMON/UNCOMMON/RARE, and then SPECIAL and CURSE. SPECIAL is for cards you only get from events. Curse is for curses, except for special curses like Curse of the Bell and Necronomicurse.
            CardTarget.NONE, //The target. Single target is ENEMY, all enemies is ALL_ENEMY. Look at cards similar to what you want to see what to use.
            COST //The card's base cost. -1 is X cost, -2 is non-defined cost for unplayable cards like curses, or Reflex.
    );


    public WedgesOfTheSky() {
        super(ID, info); //Pass the required information to the BaseCard constructor.

        setDamage(DAMAGE, UPG_DAMAGE);
        setBlock(BLOCK, UPG_BLOCK); //Sets the card's damage and how much it changes when upgraded.
        setMagic(MAGIC_NUMBER, UPG_MAGIC_NUMBER);

        this.setCostUpgrade(UPG_COST);

        this.setExhaust(EXHAUST, EXHAUST_UPG);
        this.setEthereal(ETHEREAL, UPG_ETHEREAL);
        this.setSelfRetain(RETAIN, UPG_RETAIN);
        this.setInnate(INNATE, UPG_INNATE);
        this.purgeOnUse = PURGE;

        this.actionsOnUse = new HashSet<>();
    }

    @Override
    public void upgrade() {
        if (AbstractDungeon.player != null && AbstractDungeon.player.hasRelic(OppressusFragorRelic.ID)){
            for (AbstractCard c : ((OppressusFragorRelic) AbstractDungeon.player.getRelic(OppressusFragorRelic.ID)).wedgesUpgrades.group){
                c.upgrade();
            }
        }

        super.upgrade();

        if (this.actionsOnUse != null && this.actionsOnUse.containsAll(Arrays.asList(
                ACTIONS_ENUM.ATTACK,
                ACTIONS_ENUM.DEFEND,
                ACTIONS_ENUM.BUFF_STRENGTH,
                ACTIONS_ENUM.BUFF_DEXTERITY,
                ACTIONS_ENUM.DEBUFF_WEAK,
                ACTIONS_ENUM.DEBUFF_VULNERABLE,
                ACTIONS_ENUM.DRAW
        ))){
            this.uncap();
        }

        this.purgeOnUse = UPG_PURGE;
    }

    public void uncap(){
        this.upgraded = false;
        super.upgrade();
    }

    @Override
    public boolean canPlay(AbstractCard card) {
        return false;
    }

    @Override
    public boolean canUse(AbstractPlayer p, AbstractMonster m) {
        return false;
    }

    @Override
    public void use(AbstractPlayer p, AbstractMonster m) {

        if (this.actionsOnUse.contains(ACTIONS_ENUM.ATTACK)){
            addToBot(new DamageAllEnemiesAction(p, this.damage, this.damageTypeForTurn, AbstractGameAction.AttackEffect.BLUNT_HEAVY));
        }

        if (this.actionsOnUse.contains(ACTIONS_ENUM.DEFEND)){
            addToBot(new GainBlockAction(p, this.block));
        }

        if (this.actionsOnUse.contains(ACTIONS_ENUM.BUFF_STRENGTH)){
            addToBot(new ApplyPowerAction(p, p, new StrengthPower(p, this.magicNumber), this.magicNumber));
            addToBot(new ApplyPowerAction(p, p, new FocusPower(p, this.magicNumber), this.magicNumber));
        }

        if (this.actionsOnUse.contains(ACTIONS_ENUM.BUFF_DEXTERITY)){
            addToBot(new ApplyPowerAction(p, p, new DexterityPower(p, this.magicNumber), this.magicNumber));
        }

        if (this.actionsOnUse.contains(ACTIONS_ENUM.DEBUFF_WEAK)){
            for (AbstractCreature mo : AbstractDungeon.getMonsters().monsters){
                addToBot(new ApplyPowerAction(mo, p, new WeakPower(mo, this.magicNumber, false), this.magicNumber));
            }
        }

        if (this.actionsOnUse.contains(ACTIONS_ENUM.DEBUFF_VULNERABLE)){
            for (AbstractCreature mo : AbstractDungeon.getMonsters().monsters){
                addToBot(new ApplyPowerAction(mo, p, new VulnerablePower(mo, this.magicNumber, false), this.magicNumber));
            }
        }

        if (this.actionsOnUse.contains(ACTIONS_ENUM.DRAW)){
            addToBot(new DrawCardAction(this.magicNumber));
        }
    }

    @Override
    public void initializeDescription() {
        this.rawDescription = currCardStrings.DESCRIPTION;
//                ATTACK,
//                DEFEND,
//                BUFF_STRENGTH,
//                BUFF_DEXTERITY,
//                DEBUFF_WEAK,
//                DEBUFF_VULNERABLE

        if (this.actionsOnUse != null){
            if (!this.actionsOnUse.isEmpty()){
                this.rawDescription = this.rawDescription + "When drawn: ";
            }

            if (this.actionsOnUse.contains(ACTIONS_ENUM.ATTACK)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[0];
            }

            if (this.actionsOnUse.contains(ACTIONS_ENUM.DEFEND)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[1];
            }

            if (this.actionsOnUse.contains(ACTIONS_ENUM.BUFF_STRENGTH) && this.actionsOnUse.contains(ACTIONS_ENUM.BUFF_DEXTERITY)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[2];
            } else if (this.actionsOnUse.contains(ACTIONS_ENUM.BUFF_STRENGTH)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[3];
            } else if (this.actionsOnUse.contains(ACTIONS_ENUM.BUFF_DEXTERITY)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[4];
            }

            if (this.actionsOnUse.contains(ACTIONS_ENUM.DEBUFF_WEAK) && this.actionsOnUse.contains(ACTIONS_ENUM.DEBUFF_VULNERABLE)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[5];
            } else if (this.actionsOnUse.contains(ACTIONS_ENUM.DEBUFF_WEAK)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[6];
            } else if (this.actionsOnUse.contains(ACTIONS_ENUM.DEBUFF_VULNERABLE)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[7];
            }

            if (this.actionsOnUse.contains(ACTIONS_ENUM.DRAW) && this.magicNumber == 1){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[8];
            } else if (this.actionsOnUse.contains(ACTIONS_ENUM.DRAW)){
                this.rawDescription = this.rawDescription + this.cardStrings.EXTENDED_DESCRIPTION[9];
            }
        }


        super.initializeDescription();
    }

    @Override
    public void triggerWhenDrawn() {
        super.triggerWhenDrawn();
        this.use(AbstractDungeon.player, AbstractDungeon.getCurrRoom().monsters.getRandomMonster(true));
    }
}